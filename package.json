{
  "name": "jupyter-explorer",
  "author": "lumine-code",
  "description": "Explore dataframes, arrays and nested objects in a searchable grid.",
  "repository": "https://github.com/lumine-code/jupyter-explorer",
  "bugs": {
    "url": "https://github.com/lumine-code/jupyter-explorer/issues"
  },
  "homepage": "https://github.com/lumine-code/jupyter-explorer#readme",
  "keywords": [
    "dataframe",
    "parquet",
    "arrow",
    "pandas",
    "numpy",
    "plotly",
    "grid",
    "chart"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "lumine": "^1.0.0"
  },
  "main": "./lib/main",
  "files": [
    "docs",
    "keymaps",
    "lib",
    "menus",
    "spec",
    "styles"
  ],
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "deserializers": {
    "jupyter-explorer/ExplorerPane": "deserializeExplorerPane"
  },
  "providedServices": {
    "jupyter.explorer": {
      "versions": {
        "1.0.0": "provideExplorer"
      }
    },
    "search.adapter": {
      "versions": {
        "2.0.0": "provideSearchAdapter"
      }
    },
    "background-tips.provider": {
      "versions": {
        "1.0.0": "provideBackgroundTips"
      }
    }
  },
  "consumedServices": {
    "jupyter.kernel": {
      "versions": {
        "^1.0.0": "consumeJupyterKernel"
      }
    },
    "autocomplete.watch-editor": {
      "versions": {
        "^1.0.0": "consumeAutocompleteWatchEditor"
      }
    },
    "jupyter.context": {
      "versions": {
        "^1.0.0": "consumeJupyterContext"
      }
    }
  },
  "dependencies": {
    "@lumine-code/canvas-grid": "github:lumine-code/canvas-grid#fd5460af8ec0976bf0dc1d7f76891396ca5f3afe",
    "@lumine-code/etch": "github:lumine-code/etch#3e56e2460d890ab9b85e4f1d6bef236d34230530",
    "plotly.js-dist": "^4.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
